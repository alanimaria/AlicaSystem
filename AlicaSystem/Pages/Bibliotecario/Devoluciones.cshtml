@page
@model AlicaSystem.Pages.Bibliotecario.DevolucionesModel
@{
    Layout = null;
    ViewData["Activo"] = "Devoluciones";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alica System - Registrar devolución</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/alica.css">
</head>
<body>
    <div class="app">
        <partial name="_SidebarBibliotecario" />

        <main class="stage" style="padding:32px 40px;">
            <div class="screen-title">
                <span class="eyebrow">Bibliotecario · Formulario</span>
                <h1>Registrar devolución</h1>
                <p>Busca al usuario por matrícula y registra la devolución de su(s) libro(s).</p>
            </div>

            @Html.AntiForgeryToken()

            <div class="card pad-l" style="max-width:720px;">
                <div class="field-group">
                    <label class="field-label">Usuario (matrícula) <span class="req">*</span></label>
                    <div style="display:flex; gap:8px;">
                        <input class="field" id="matriculaLector" placeholder="Ej: 2024-0128">
                        <button type="button" class="btn btn-ghost" onclick="buscarLector()"><i class="bi bi-search"></i></button>
                    </div>
                    <div class="field-help" id="resultadoLector">Todavía no se ha buscado ningún usuario</div>
                </div>

                <div id="listaPrestamos"></div>

                <p id="resultadoFinal" style="margin-top:12px;"></p>
            </div>
        </main>
    </div>

    <script>
            async function buscarLector() {
                const matricula = document.getElementById('matriculaLector').value;
                const resp = await fetch('?handler=BuscarLector&matricula=' + encodeURIComponent(matricula));
                const data = await resp.json();
                const texto = document.getElementById('resultadoLector');
                const contenedor = document.getElementById('listaPrestamos');
                contenedor.innerHTML = '';

                if (!data.encontrado) {
                    texto.style.color = '#b3261e';
                    texto.innerText = 'Usuario no encontrado.';
                    return;
                }

                texto.style.color = '';
                texto.innerText = data.nombreCompleto;

                if (data.prestamos.length === 0) {
                    contenedor.innerHTML = '<div class="empty-state" style="margin-top:14px;"><h4>Sin préstamos activos</h4><p>Este usuario no tiene libros pendientes por devolver.</p></div>';
                    return;
                }

                let html = '<table style="margin-top:14px;"><thead><tr><th>Libro</th><th>Devolución esperada</th><th>Atraso</th><th></th></tr></thead><tbody>';
                data.prestamos.forEach(p => {
                    const atraso = p.diasAtraso > 0
                        ? `<span class="stamp danger">${p.diasAtraso} día(s)</span>`
                        : `<span class="stamp ok">A tiempo</span>`;
                    html += `<tr>
                        <td>${p.titulo}<div class="sub">${p.codigoInterno}</div></td>
                        <td>${p.fechaDevEsperada}</td>
                        <td>${atraso}</td>
                        <td><button type="button" class="btn btn-primary btn-sm" onclick="registrarDevolucion(${p.idPrestamo})"><i class="bi bi-check-lg"></i> Devolver</button></td>
                    </tr>`;
                });
                html += '</tbody></table>';
                contenedor.innerHTML = html;
            }

            async function registrarDevolucion(idPrestamo) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                const body = new URLSearchParams();
                body.append('idPrestamo', idPrestamo);
                body.append('__RequestVerificationToken', token);

                const resp = await fetch('?handler=Registrar', { method: 'POST', body: body });
                const data = await resp.json();

                const resultado = document.getElementById('resultadoFinal');
                resultado.style.color = data.exito ? '' : '#b3261e';
                resultado.innerText = data.mensaje;

                if (data.exito) {
                    buscarLector(); // refresca la lista, ese préstamo ya no debería aparecer
                }
            }
    </script>
</body>
</html>