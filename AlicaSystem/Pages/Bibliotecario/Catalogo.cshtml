@page
@model AlicaSystem.Pages.Bibliotecario.CatalogoModel
@{
    Layout = null;
    ViewData["Activo"] = "Catalogo";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alica System - Catálogo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/alica.css">
</head>
<body>
    <div class="app">
        <partial name="_SidebarBibliotecario" />

        <main class="stage" style="padding:32px 40px;">
            <div class="screen-title">
                <span class="eyebrow">Bibliotecario · Consulta</span>
                <h1>Catálogo</h1>
                <p>Consulta el catálogo completo para orientar a los usuarios.</p>
            </div>

            <form method="get" class="search-bar" style="margin-bottom:16px;">
                <input class="field" type="text" name="busqueda" value="@Model.Busqueda" placeholder="Buscar por título o código...">
                <select class="field" name="idCategoria" style="max-width:220px;">
                    <option value="">Todas las categorías</option>
                    @foreach (var c in Model.Categorias)
                    {
                        <option value="@c.IdCategoria" selected="@(Model.IdCategoria == c.IdCategoria)">@c.Nombre</option>
                    }
                </select>
                <button class="btn btn-ghost" type="submit"><i class="bi bi-search"></i></button>
            </form>

            <div class="card pad-m">
                <table>
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th class="hide-mobile">Categoría</th>
                            <th class="hide-mobile">Ubicación</th>
                            <th>Disponibilidad</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Libros.Count == 0)
                        {
                            <tr><td colspan="5">No se encontraron libros.</td></tr>
                        }
                        @foreach (var l in Model.Libros)
                        {
                            <tr>
                                <td>@l.Titulo<div class="sub">@l.CodigoInterno · @l.Autores</div></td>
                                <td class="hide-mobile">@l.Categoria</td>
                                <td class="hide-mobile">@(l.Ubicacion ?? "-")</td>
                                <td><span class="stamp @(l.CantidadDisponible > 0 ? "ok" : "danger")">@l.CantidadDisponible / @l.CantidadTotal</span></td>
                                <td><a class="btn btn-ghost btn-sm" href="/Bibliotecario/FichaLibro?id=@l.IdLibro">Ver ficha</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
    <script src="~/js/site.js"></script>
</body>
</html>