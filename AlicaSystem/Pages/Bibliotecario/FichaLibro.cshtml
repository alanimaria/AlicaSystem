@page
@model AlicaSystem.Pages.Bibliotecario.FichaLibroModel
@{
    Layout = null;
    ViewData["Activo"] = "Catalogo";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alica System - Ficha de libro</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/alica.css">
</head>
<body>
    <div class="app">
        <partial name="_SidebarBibliotecario" />

        <main class="stage" style="padding:32px 40px;">
            <div class="screen-title">
                <span class="eyebrow">Bibliotecario · Consulta</span>
                <h1>Ficha de libro</h1>
                <p><a href="/Bibliotecario/Catalogo" style="font-size:12.5px;">← Volver al catálogo</a></p>
            </div>

            @if (Model.Libro != null)
            {
                var l = Model.Libro;
                <div class="card pad-l" style="max-width:640px;">
                    <div style="display:flex; gap:16px; align-items:center; margin-bottom:20px;">
                        <div>
                            <div><strong>Categoría:</strong> @l.Categoria</div>
                            <div><strong>Ubicación:</strong> @(l.Ubicacion ?? "No especificada")</div>
                            <div><strong>Disponibilidad:</strong> @l.CantidadDisponible / @l.CantidadTotal ejemplares</div>
                            <div><strong>Estado:</strong> @l.EstadoDisponibilidad</div>
                            @if (!string.IsNullOrEmpty(l.Descripcion))
                            {
                                <div style="margin-top:8px;"><strong>Descripción:</strong> @l.Descripcion</div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(l.PortadaUrl))
                        {
                            <div style="width:180px; height:280px; flex:none; border-radius:6px; overflow:hidden; margin-left:auto;">
                                <img src="@l.PortadaUrl" style="width:100%; height:100%; object-fit:cover;">
                            </div>
                        }
                        else
                        {
                            <div class="book-cover cover-1" style="width:180px; height:280px; flex:none; font-size:11px; padding:8px; margin-left:auto;">@l.Titulo</div>
                        }
                    </div>

                    @if (l.CantidadDisponible > 0)
                    {
                        <a class="btn btn-primary" href="/Bibliotecario/RegistrarPrestamo?codigo=@l.CodigoInterno">
                            <i class="bi bi-journal-plus"></i> Prestar este libro
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-ghost" disabled>Sin ejemplares disponibles</button>
                    }
                </div>
            }

        </main>
    </div>
    <script src="~/js/site.js"></script>
</body>
</html>