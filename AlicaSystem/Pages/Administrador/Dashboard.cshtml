@page
@model AlicaSystem.Pages.Administrador.DashboardModel
@{
    Layout = null;
    ViewData["Activo"] = "Dashboard";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alica System - Panel administrador</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/alica.css">
</head>
<body>
    <div class="app">
        <partial name="_SidebarAdministrador" />

        <main class="stage" style="padding:32px 40px;">
            <div class="screen-title">
                <span class="eyebrow">Administrador · Menú principal</span>
                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
                    <h1>Panel general del sistema</h1>
                    <span class="badge-role">@Model.NombreUsuario</span>
                </div>
                <p>Visión general del catálogo, usuarios, préstamos y actividad del sistema.</p>
            </div>

            <div class="kpis" style="margin-bottom:22px;">
                <div class="stat-card">
                    <div class="label">Libros en catálogo</div>
                    <div class="value">@Model.LibrosEnCatalogo.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="label">Usuarios activos</div>
                    <div class="value">@Model.UsuariosActivos.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="label">Préstamos activos</div>
                    <div class="value">@Model.PrestamosActivos.ToString("N0")</div>
                </div>
                <div class="stat-card">
                    <div class="label">Multas pendientes</div>
                    <div class="value">RD$ @Model.ResumenMultas.TotalPendiente.ToString("N0")</div>
                    <div class="foot">@Model.ResumenMultas.UsuariosConSaldo usuarios</div>
                </div>
            </div>

            <div class="grid-2">
                <div class="card pad-m">
                    <div class="section-head"><h2 style="font-size:16px;">Libros más prestados</h2></div>
                    @if (Model.TopLibros.Count == 0)
                    {
                        <p style="color:var(--ink-soft); font-size:13px;">Aún no hay préstamos registrados.</p>
                    }
                    else
                    {
                        @foreach (var libro in Model.TopLibros)
                        {
                            <div class="bar-row">
                                <div class="bar-label">@libro.Libro</div>
                                <div class="bar-track"><div class="bar-fill" style="width:@(libro.BarraAncho)%;"></div></div>
                                <div class="bar-value">@libro.CantidadPrestamos</div>
                            </div>
                        }
                    }
                </div>
                <div class="card pad-m">
                    <div class="section-head"><h2 style="font-size:16px;">Accesos rápidos</h2></div>
                    <div style="display:flex; flex-direction:column; gap:8px;">
                        <button class="btn btn-ghost btn-block" style="justify-content:flex-start;" onclick="location.href='/Administrador/GestionarLibros'">
                            <i class="bi bi-journal-bookmark"></i> Gestionar libros y autores
                        </button>
                        <button class="btn btn-ghost btn-block" style="justify-content:flex-start;" onclick="location.href='/Administrador/GestionarPersonas'">
                            <i class="bi bi-people"></i> Gestionar usuarios
                        </button>
                        <button class="btn btn-ghost btn-block" style="justify-content:flex-start;" onclick="location.href='/Administrador/GestionarEmpleados'">
                            <i class="bi bi-person-workspace"></i> Gestionar empleados
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>