@page
@model AlicaSystem.Pages.Administrador.ReportesModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alica System - Reportes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/alica.css">
</head>
<body>
    <div class="app">
        <partial name="_SidebarAdministrador" view-data="ViewData" />
        <main class="stage" style="padding:32px;">

            <div class="screen-title">
                <span class="eyebrow">Administrador · Reportes</span>
                <div><h1>Reportes</h1><p>Resumen de actividad del sistema.</p></div>
            </div>

            <form method="get" class="search-bar" style="margin-bottom:24px; gap:10px;">
                <div class="field-group" style="margin:0;">
                    <label class="field-label">Desde</label>
                    <input class="field" type="date" asp-for="Desde">
                </div>
                <div class="field-group" style="margin:0;">
                    <label class="field-label">Hasta</label>
                    <input class="field" type="date" asp-for="Hasta">
                </div>
                <button class="btn btn-primary" type="submit" style="align-self:flex-end;">Filtrar</button>
            </form>

            <div class="grid-2">
                <div class="card pad-m">
                    <div class="section-head">
                        <h3 style="font-size:14.5px;">Préstamos por período</h3>
                        <a class="btn btn-ghost btn-sm" href="?handler=Exportar&tabla=prestamos&Desde=@Model.Desde.ToString("yyyy-MM-dd")&Hasta=@Model.Hasta.ToString("yyyy-MM-dd")"><i class="bi bi-download"></i> CSV</a>
                    </div>
                    <table>
                        <thead><tr><th>Estado</th><th>Total</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Prestamos)
                            {
                                <tr><td>@r.Estado</td><td>@r.Total</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card pad-m">
                    <div class="section-head">
                        <h3 style="font-size:14.5px;">Disponibilidad de catálogo</h3>
                        <a class="btn btn-ghost btn-sm" href="?handler=Exportar&tabla=catalogo"><i class="bi bi-download"></i> CSV</a>
                    </div>
                    <table>
                        <thead><tr><th>Estado</th><th>Libros</th><th class="hide-mobile">Disp.</th><th class="hide-mobile">Total</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Catalogo)
                            {
                                <tr><td>@r.Estado</td><td>@r.Total</td><td class="hide-mobile">@r.EjemplaresDisponibles</td><td class="hide-mobile">@r.EjemplaresTotales</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card pad-m">
                    <div class="section-head">
                        <h3 style="font-size:14.5px;">Multas por período</h3>
                        <a class="btn btn-ghost btn-sm" href="?handler=Exportar&tabla=multas&Desde=@Model.Desde.ToString("yyyy-MM-dd")&Hasta=@Model.Hasta.ToString("yyyy-MM-dd")"><i class="bi bi-download"></i> CSV</a>
                    </div>
                    <table>
                        <thead><tr><th>Estado</th><th>Total</th><th>Monto (RD$)</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.Multas)
                            {
                                <tr><td>@r.Estado</td><td>@r.Total</td><td>@r.MontoTotal.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card pad-m">
                    <div class="section-head">
                        <h3 style="font-size:14.5px;">Libros más prestados</h3>
                        <a class="btn btn-ghost btn-sm" href="?handler=Exportar&tabla=libros"><i class="bi bi-download"></i> CSV</a>
                    </div>
                    <table>
                        <thead><tr><th>Libro</th><th>Préstamos</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.LibrosMasPrestados)
                            {
                                <tr><td>@r.Nombre</td><td>@r.Cantidad</td></tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card pad-m">
                    <div class="section-head">
                        <h3 style="font-size:14.5px;">Usuarios más activos</h3>
                        <a class="btn btn-ghost btn-sm" href="?handler=Exportar&tabla=usuarios"><i class="bi bi-download"></i> CSV</a>
                    </div>
                    <table>
                        <thead><tr><th>Usuario</th><th>Préstamos</th></tr></thead>
                        <tbody>
                            @foreach (var r in Model.UsuariosMasActivos)
                            {
                                <tr><td>@r.Nombre</td><td>@r.Cantidad</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
    <script src="~/js/site.js"></script>
</body>
</html>