@page
@model AlicaSystem.Pages.Administrador.GestionarRolesModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alica System - Roles</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/alica.css">
</head>
<body>
    <div class="app">
        <partial name="_SidebarAdministrador" view-data="ViewData" />
        <main class="stage" style="padding:32px;">

            <div class="screen-title">
                <span class="eyebrow">Administrador · Personas</span>
                <div style="display:flex; justify-content:space-between; align-items:flex-end; flex-wrap:wrap; gap:12px;">
                    <div><h1>Roles</h1><p>Define los roles disponibles para el personal del sistema.</p></div>
                    <a class="btn btn-brass" href="/Administrador/GestionarRoles">＋ Nuevo rol</a>
                </div>
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <p>@TempData["Mensaje"]</p>
            }

            <div class="grid-2" style="grid-template-columns:1.3fr .9fr; align-items:flex-start;">
                <div class="card pad-m">
                    <table>
                        <thead>
                            <tr>
                                <th>Rol</th>
                                <th class="hide-mobile">Descripción</th>
                                <th class="hide-mobile">Empleados</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Roles)
                            {
                                <tr>
                                    <td>@r.Nombre</td>
                                    <td class="hide-mobile">@r.Descripcion</td>
                                    <td class="hide-mobile">@r.CantidadEmpleados</td>
                                    <td>
                                        <a class="btn btn-ghost btn-sm" href="/Administrador/GestionarRoles?id=@r.IdRol">Editar</a>
                                        @if (r.CantidadEmpleados == 0)
                                        {
                                            <form method="post" asp-page-handler="Eliminar" class="confirm-delete" style="display:inline;">
                                                <input type="hidden" name="id" value="@r.IdRol" />
                                                <button type="submit" class="btn btn-danger btn-sm">Eliminar</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-danger btn-sm" disabled title="No se puede eliminar: hay empleados con este rol">Eliminar</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card pad-l">
                    <h3 style="font-size:15px; margin-bottom:16px;">Registrar / editar rol</h3>
                    <form method="post">
                        <input type="hidden" asp-for="IdRol" />
                        <div class="field-group"><label class="field-label">Nombre del rol <span class="req">*</span></label><input class="field" asp-for="Nombre" placeholder="Ej. Bibliotecario"></div>
                        <div class="field-group"><label class="field-label">Descripción</label><textarea class="field" rows="4" asp-for="Descripcion" placeholder="Describe las responsabilidades del rol…"></textarea></div>
                        <button class="btn btn-primary btn-block" type="submit">Guardar rol</button>
                    </form>
                </div>
            </div>

        </main>
    </div>
</body>
</html>